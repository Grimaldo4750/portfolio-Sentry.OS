# DEV configuration. Authenticates against the real Sentry.OS.IdentityServer OAuth2/OIDC surface
# served behind the reverse proxy at https://localhost/SentryOS (Authorization Code + PKCE).
VITE_OIDC_AUTHORITY=https://localhost/SentryOS
VITE_OIDC_CLIENT_ID=sentry-management-web-app
VITE_OIDC_REDIRECT_URI=http://localhost:5174/callback
VITE_ADMIN_API_BASE_URL=https://localhost/SentryOSManagementAPI
