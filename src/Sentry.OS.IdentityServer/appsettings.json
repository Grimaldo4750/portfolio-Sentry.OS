{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "https://localhost:5001",
    "Audience": "api-sentry-management"
  },
  "RateLimiting": {
    "Authentication": {
      "PermitLimit": 20,
      "WindowSeconds": 60
    }
  }
}
